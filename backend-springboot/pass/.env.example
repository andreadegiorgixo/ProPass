# Copia questo file in ".env" (nella cartella pass/) e inserisci i valori reali.
# ".env" e' ignorato da git: non committarlo mai.

# URL JDBC: jdbc:oracle:thin:@//<host>:<porta>/<nome servizio>
DB_URL=jdbc:oracle:thin:@//localhost:1522/PROPASS

# Utente applicativo creato su Oracle (non SYSTEM)
DB_USERNAME=

# Password di quell'utente
DB_PASSWORD=
