# === ProPass - configurazione Docker (copia in .env) ===
# Modifica qui i valori; docker-compose.yml li legge in automatico.

# Porta sul tuo computer (cambiala se 1522 e' gia' occupata).
ORACLE_HOST_PORT=1522

# Utente amministratore: SYSTEM (la password vale anche per SYS e PDBADMIN).
# Scegline una tua: senza valore il container non parte.
ORACLE_ADMIN_PASSWORD=

# Nome del database (PDB) = "Service Name" in SQL Developer
ORACLE_DATABASE=PROPASS
